DEVICE_SECRET=
COOKIE_SECURE=false
# Set the exact observed peer of your reverse proxy; Docker Desktop may use a gateway IP.
# Example only: TRUSTED_PROXY_CIDRS=172.18.0.1/32
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Required database credentials. The backend refuses to start without them.
# Generate the password with: openssl rand -hex 24  (at least 16 characters)
MARIADB_USER=
MARIADB_PASSWORD=
# Optional; defaults shown.
# MARIADB_HOST=host.docker.internal
# MARIADB_PORT=3306
# MARIADB_DATABASE=onlinejudge

# Optional exact IP/name overrides; otherwise use reverse DNS. Keep DHCP reservations in sync.
DEVICE_NAME_MAP=

# Offline LAN exam: every seat has its own fixed IP (DHCP reservation or static) and no NAT.
# true binds sessions to the login IP, treats a copied device cookie used from another IP
# as a different device, and allows only one account per IP within three hours.
# Keep false when several machines share one IP (NAT), or every seat behind it is blocked.
LAN_EXAM_MODE=false
# false closes self-registration; use accounts prepared by the administrator during exams.
ALLOW_REGISTRATION=true
