DEVICE_SECRET=
COOKIE_SECURE=false
# Set the exact observed peer of your reverse proxy; Docker Desktop may use a gateway IP.
# Example only: TRUSTED_PROXY_CIDRS=172.18.0.1/32
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Optional exact IP/name overrides; otherwise use reverse DNS. Keep DHCP reservations in sync.
DEVICE_NAME_MAP=
